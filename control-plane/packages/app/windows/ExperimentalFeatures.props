<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="Microsoft.ReactNative Experimental Features">
    <!--
      Required for building a Paper / UWP Architecture project.
    -->
    <RnwNewArch>false</RnwNewArch>

    <!--
      Build framework from source in legacy Paper mode.
    -->
    <UseExperimentalNuget>false</UseExperimentalNuget>

    <!-- Suppress WinAppSDK transitive checks for legacy UWP projects -->
    <WindowsAppSDKVerifyTransitiveDependencies>false</WindowsAppSDKVerifyTransitiveDependencies>
    <RunCodegenWindows>false</RunCodegenWindows>
    <ReactExperimentalFeaturesSet>true</ReactExperimentalFeaturesSet>
  </PropertyGroup>

</Project>
