{
  "type": "module",
  "name": "@ompd/core",
  "version": "17.2.15",
  "description": "Shared daemon contracts, client, policy, pairing, and durable store for ompd",
  "homepage": "https://omp.sh",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "control-plane/packages/core"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "ompd",
    "daemon",
    "control-plane",
    "agent",
    "protocol"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "bun ../../scripts/check-types.ts tsconfig.json"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts"
    },
    "./ompd-client": {
      "types": "./src/ompd-client.ts",
      "import": "./src/ompd-client.ts"
    },
    "./policy": {
      "types": "./src/policy.ts",
      "import": "./src/policy.ts"
    },
    "./pairing": {
      "types": "./src/pairing.ts",
      "import": "./src/pairing.ts"
    },
    "./redact": {
      "types": "./src/redact.ts",
      "import": "./src/redact.ts"
    },
    "./store": {
      "types": "./src/store.ts",
      "import": "./src/store.ts"
    },
    "./handoff-container": {
      "types": "./src/handoff-container.ts",
      "import": "./src/handoff-container.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
